%% sbc-template.sty
%% Estilo para artigos no formato da Sociedade Brasileira de Computação (SBC):
%% A4, Times 12pt, margens de 3 cm (sup.) / 2 cm (inf.) / 3 cm (esq.) / 2 cm (dir.),
%% título 16pt negrito, autores 12pt negrito, endereços 12pt,
%% abstract/resumo em itálico recuados 0,8 cm, seções numeradas em negrito.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2026/10/23 Estilo de artigos SBC]

\RequirePackage{times}

% ---------------- Página ----------------
\setlength{\paperwidth}{210mm}
\setlength{\paperheight}{297mm}
\setlength{\textwidth}{160mm}
\setlength{\textheight}{247mm}
\setlength{\oddsidemargin}{0.46cm}   % 1in + 0,46cm ~ 3 cm
\setlength{\evensidemargin}{0.46cm}
\setlength{\topmargin}{-0.54cm}      % 1in - 0,54cm ~ 2 cm até o cabeçalho
\setlength{\headheight}{0pt}
\setlength{\headsep}{1cm}
\setlength{\footskip}{1cm}
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{6pt}
\pagestyle{empty}

% ---------------- Título, autores, endereços ----------------
\newcommand{\inst}[1]{\ensuremath{^{#1}}}
\def\@address{}
\newcommand{\address}[1]{\gdef\@address{#1}}
\newcommand{\email}[1]{\texttt{#1}}

\renewcommand{\maketitle}{%
  \par
  \begin{center}
    {\fontsize{16}{20}\selectfont\bfseries \@title\par}
    \vspace{12pt}
    {\fontsize{12}{14}\selectfont\bfseries \@author\par}
    \vspace{6pt}
    {\fontsize{12}{14}\selectfont \@address\par}
  \end{center}
  \vspace{6pt}
  \thispagestyle{empty}
}

% ---------------- Abstract e Resumo ----------------
\renewenvironment{abstract}%
  {\list{}{\leftmargin=0.8cm\rightmargin=0.8cm\listparindent=0pt\parsep=0pt}%
   \item\relax\itshape\textbf{\upshape\itshape Abstract.}\ }%
  {\endlist\vspace{6pt}}
\newenvironment{resumo}%
  {\list{}{\leftmargin=0.8cm\rightmargin=0.8cm\listparindent=0pt\parsep=0pt}%
   \item\relax\itshape\textbf{Resumo.}\ }%
  {\endlist\vspace{6pt}}

% ---------------- Seções ----------------
\renewcommand{\section}{\@startsection{section}{1}{0pt}%
  {-12pt}{6pt}{\fontsize{13}{15}\selectfont\bfseries}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{0pt}%
  {-12pt}{6pt}{\fontsize{12}{14}\selectfont\bfseries}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{0pt}%
  {-12pt}{6pt}{\fontsize{12}{14}\selectfont\bfseries}}
\renewcommand{\@seccntformat}[1]{\csname the#1\endcsname.\ }

% ---------------- Legendas ----------------
\long\def\@makecaption#1#2{%
  \vskip 6pt
  \sbox\@tempboxa{\small\textbf{#1.} #2}%
  \ifdim\wd\@tempboxa>\hsize
    {\small\textbf{#1.} #2\par}%
  \else
    \hbox to\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip 6pt}

% ---------------- Referências ----------------
% Citações no formato [Autor Ano]; a lista sai sob o título "References".
\renewcommand{\@biblabel}[1]{}
\renewenvironment{thebibliography}[1]%
  {\section*{References}%
   \list{}{\leftmargin=0.5cm\itemindent=-0.5cm\itemsep=3pt\parsep=0pt}%
   \small\sloppy\clubpenalty4000\widowpenalty4000\sfcode`\.=1000\relax}%
  {\endlist}
\let\@openbib@code\relax

\endinput
